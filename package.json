{
  "name": "futures-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --mode single",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "screens": "node scripts/screenshots.mjs",
    "smoke": "node scripts/smoke-custom.mjs && node scripts/smoke-journal.mjs",
    "build:pwa": "tsc -b && vite build",
    "build:single": "tsc -b && vite build --mode single",
    "test:e2e": "node scripts/smoke-journal.mjs",
    "test:ios": "node scripts/check-ios-dates.mjs"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "playwright": "^1.64.1",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^4.1.12"
  }
}
